<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stealth Dashboard</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
    }

    body {
      background: #000;
      color: #f5f5f5;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .container {
      width: 100%;
      max-width: 420px;
      padding: 24px;
    }

    .panel {
      background: radial-gradient(circle at top, #222 0, #050505 55%, #000 100%);
      border-radius: 18px;
      padding: 28px 22px 26px;
      border: 1px solid #222;
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
    }

    .title {
      text-align: center;
      font-size: 1rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 20px;
    }

    /* PIN SCREEN */
    #pin-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }

    .pin-instruction {
      font-size: 0.85rem;
      color: #aaa;
      text-align: center;
    }

    .pin-dots {
      display: flex;
      gap: 10px;
      margin-top: 6px;
      margin-bottom: 8px;
    }

    .pin-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 1px solid #444;
      background: #050505;
      box-shadow: 0 0 4px rgba(0, 0, 0, 0.7);
      transition: background 0.15s ease, border-color 0.15s ease;
    }

    .pin-dot.filled {
      background: #0af;
      border-color: #0af;
    }

    .pin-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 8px;
    }

    .pin-key {
      width: 70px;
      height: 50px;
      border-radius: 12px;
      border: 1px solid #222;
      background: #101010;
      color: #eee;
      font-size: 1.05rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      user-select: none;
      transition: background 0.13s ease, transform 0.08s ease, border-color 0.13s ease;
    }

    .pin-key:active {
      transform: scale(0.96);
      background: #181818;
      border-color: #333;
    }

    .error-msg {
      min-height: 18px;
      margin-top: 4px;
      font-size: 0.8rem;
      color: #f55;
      text-align: center;
      letter-spacing: 0.03em;
    }

    /* DASHBOARD */
    #dashboard {
      display: none;
      flex-direction: column; 
      gap: 16px;
    }

    .protocol-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: #666;
      text-align: center;
    }

    .protocol-text {
      margin-top: 4px;
      font-size: 0.95rem;
      color: #d0d0d0;
      text-align: center;
      font-weight: 500;
    }

    .display-box {
      width: 100%;
      background: rgba(10, 10, 10, 0.9);
      border: 1px solid #1f1f1a;
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 0.75rem;
      color: #777;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .display-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .display-val {
      color: #aaa;
      font-family: monospace;
    }

    .display-val.active-state {
      color: #0af;
      font-weight: bold;
    }

    /* Signal visualizer bars */
    .signal-container {
      margin-top: 4px;
    }
    
    .signal-header {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #555;
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
    }

    .signal-bars {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      height: 40px;
      gap: 3px;
      padding: 4px;
      background: #020202;
      border: 1px solid #151515;
      border-radius: 6px;
    }

    .bar {
      flex: 1;
      height: 15%;
      background: #201010;
      border-radius: 1px;
      transition: height 0.1s ease, background-color 0.2s ease;
    }

    .bar.signal-peak {
      background: #441010;
    }

    .bar.blended {
      background: #103320;
    }

    .toggle-wrapper {
      margin: 8px 0;
      display: flex;
      justify-content: center;
      width: 100%;
    }

    .power-toggle {
      position: relative;
      width: 84px; 
      height: 84px;
      border-radius: 50%;
      border: 2px solid #330000;
      background: radial-gradient(circle at 30% 0, #222 0, #050505 55%, #000 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 24px rgba(0, 0, 0, 0.8);
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .power-toggle.off {
      border-color: #550000;
      box-shadow: 0 0 20px rgba(255, 0, 0, 0.15);
    }

    .power-toggle.on {
      border-color: #00aa55;
      box-shadow: 0 0 24px rgba(0, 255, 120, 0.35);
      background: radial-gradient(circle at 30% 0, #1e3b2a 0, #031108 55%, #000 100%);
    }

    .power-symbol {
      position: relative;
      width: 34px;
      height: 34px;
    }

    .power-circle {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 4px solid currentColor;
      border-top-color: transparent;
      border-right-color: transparent;
      transform: rotate(-45deg);
    }

    .power-line {
      position: absolute;
      left: 50%;
      top: 4px;
      width: 4px;
      height: 14px;
      border-radius: 999px;
      background: currentColor;
      transform: translateX(-50%);
    }

    .status-text {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #c33;
      text-align: center;
    }

    .status-text.on {
      color: #4fd57a;
    } 

    .log-terminal {
      width: 100%;
      background: #020202;
      border: 1px solid #181818;
      border-radius: 8px;
      height: 65px;
      padding: 8px 10px;
      font-family: monospace;
      font-size: 0.65rem;
      color: #555;
      overflow-y: hidden;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .log-entry {
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }
    
    .log-entry.success { color: #4fd57a; }
    .log-entry.warn { color: #f55; }
    .log-entry.info { color: #0af; }

    @media (max-width: 480px) {
      .panel {
        padding: 22px 16px;
      }
      .pin-key {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="panel">
      <div class="title">Access</div>

      <!-- PIN SCREEN -->
      <div id="pin-screen">
        <div class="pin-instruction">
          Enter access code
          <div class="pin-dots">
            <div class="pin-dot" data-index="0"></div>
            <div class="pin-dot" data-index="1"></div>
            <div class="pin-dot
