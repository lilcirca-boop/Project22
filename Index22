<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Team Shade – Signal Deck</title>

  <style>
    :root {
      --bg-main: #05070b;
      --bg-elevated: #0b0f18;
      --bg-card: #0f1724;
      --accent: #38bdf8;
      --accent-soft: rgba(56, 189, 248, 0.14);
      --accent-strong: rgba(56, 189, 248, 0.35);
      --danger: #f97373;
      --danger-soft: rgba(248, 113, 113, 0.14);
      --ok: #22c55e;
      --ok-soft: rgba(34, 197, 94, 0.16);
      --text-main: #e5e9f5;
      --text-muted: #6b7280;
      --border-subtle: rgba(148, 163, 184, 0.20);
      --shadow-soft: 0 22px 60px rgba(15, 23, 42, 0.75);
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-full: 999px;
      --transition-fast: 160ms ease-out;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", sans-serif;
      background: radial-gradient(circle at top, #020617 0, #020617 32%, #000 100%);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }

    .app-shell {
      width: 100%;
      max-width: 1120px;
      background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.18), transparent 55%),
                  radial-gradient(circle at bottom right, rgba(56, 189, 248, 0.20), transparent 60%),
                  var(--bg-main);
      border-radius: 24px;
      border: 1px solid rgba(148, 163, 184, 0.30);
      box-shadow: var(--shadow-soft);
      padding: 1px;
      position: relative;
      overflow: hidden;
    }

    .app-inner {
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.9), rgba(2, 6, 23, 0.98));
      border-radius: 23px;
      padding: 18px 18px 20px;
      border: 1px solid rgba(15, 23, 42, 0.9);
      position: relative;
      overflow: hidden;
    }

    .top-glow-ring {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% -18%, rgba(148, 163, 255, 0.28), transparent 64%),
        radial-gradient(circle at -8% 10%, rgba(59, 130, 246, 0.16), transparent 55%),
        radial-gradient(circle at 108% 12%, rgba(56, 189, 248, 0.20), transparent 60%);
      mix-blend-mode: screen;
      opacity: 0.9;
    }

    .auth-layer {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 18px;
      max-width: 420px;
      margin: 32px auto 36px;
      padding: 24px 22px 22px;
      border-radius: 22px;
      background:
        radial-gradient(circle at 0 0, rgba(56, 189, 248, 0.40), transparent 55%),
        radial-gradient(circle at 100% 0, rgba(30, 64, 175, 0.65), transparent 60%),
        linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98));
      border: 1px solid rgba(129, 140, 248, 0.60);
      box-shadow:
        0 0 0 1px rgba(129, 140, 248, 0.38),
        0 20px 50px rgba(15, 23, 42, 0.90);
    }

    .auth-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-orb {
      width: 32px;
      height: 32px;
      border-radius: 14px;
      background:
        radial-gradient(circle at 25% 20%, #e0f2fe, transparent 55%),
        radial-gradient(circle at 80% 80%, #0ea5e9, transparent 60%),
        radial-gradient(circle at 120% 0%, #1d4ed8, transparent 70%);
      border: 1px solid rgba(191, 219, 254, 0.55);
      box-shadow:
        0 0 0 1px rgba(15, 23, 42, 0.85),
        0 10px 30px rgba(15, 23, 42, 0.95);
      position: relative;
      overflow: hidden;
    }

    .brand-orb::after {
      content: "";
      position: absolute;
      inset: 2px;
      border-radius: 11px;
      border: 1px solid rgba(15, 23, 42, 0.55);
      box-shadow: inset 0 0 12px rgba(15, 23, 42, 0.55);
    }

    .brand-text-main {
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #e5e7eb;
    }

    .brand-text-sub {
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(148, 163, 184, 0.96);
    }

    .auth-tag {
      padding: 6px 11px;
      border-radius: 999px;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      border: 1px solid rgba(191, 219, 254, 0.45);
      color: #e0f2fe;
      background:
        radial-gradient(circle at 0 0, rgba(56, 189, 248, 0.38), transparent 55%),
        rgba(15, 23, 42, 0.95);
      box-shadow:
        0 0 0 1px rgba(15, 23, 42, 0.90),
        0 10px 30px rgba(15, 23, 42, 0.90);
    }

    .auth-body {
      margin-top: 6px;
    }

    .auth-title {
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #e5e7eb;
      margin-bottom: 4px;
    }

    .auth-subtitle {
      font-size: 0.82rem;
      line-height: 1.5;
      color: rgba(209, 213, 219, 0.9);
    }

    .pin-wrapper {
      margin-top: 20px;
      padding: 14px 13px 13px;
      border-radius: 16px;
      border: 1px solid rgba(148, 163, 184, 0.35);
      background:
        radial-gradient(circle at 0 0, rgba(59, 130, 246, 0.20), transparent 55%),
        radial-gradient(circle at 100% 0, rgba(56, 189, 248, 0.22), transparent 55%),
        rgba(15, 23, 42, 0.96);
    }

    .pin-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .pin-label-group {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .pin-label-primary {
      font-size: 0.9rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #e5e7eb;
    }

    .pin-label-secondary {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(148, 163, 184, 0.95);
    }

    .pin-input-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pin-input-slot {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      border: 1px solid rgba(148, 163, 184, 0.55);
      background: radial-gradient(circle at 0 0, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 1));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: #e5e7eb;
      box-shadow:
        0 0 0 1px rgba(15, 23, 42, 0.95),
        0 10px 25px rgba(15, 23, 42, 0.9);
    }

    .pin-input-slot.empty {
      color: rgba(148, 163, 184, 0.55);
    }

    .pin-hidden-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .pin-meta {
      margin-top: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.74rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(148, 163, 184, 0.92);
    }

    .auth-footer {
      margin-top: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .auth-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 11px;
      border-radius: 999px;
      border: 1px solid rgba(34, 197, 94, 0.55);
      background:
        radial-gradient(circle at 0 0, rgba(34, 197, 94, 0.35), transparent 55%),
        rgba(15, 23, 42, 0.96);
      color: rgba(220, 252, 231, 0.96);
      font-size: 0.74rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .auth-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 8px rgba(34, 197, 94, 0.85);
    }

    .auth-hint {
      font-size: 0.74rem;
      color: rgba(209, 213, 219, 0.92);
      letter-spacing: 0.10em;
      text-transform: uppercase;
    }

    @media (max-width: 640px) {
      .auth-layer {
        margin: 22px auto 18px;
        padding: 18px 16px 16px;
      }

      .pin-input-slot {
        width: 34px;
        height: 34px;
        border-radius: 12px;
      }

      .auth-title {
        font-size: 1.12rem;
      }
    }
  </style>
</head>
<body>
  <div class="app-shell">
    <div class="app-inner">
      <div class="top-glow-ring"></div>

      <!-- AUTH LAYER / PIN SCREEN -->
      <section class="auth-layer" id="auth-layer">
        <header class="auth-header">
          <div class="brand-mark">
            <div class="brand-orb"></div>
            <div>
              <div class="brand-text-main">Team Shade</div>
              <div class="brand-text-sub">Field Ops Relay</div>
            </div>
          </div>

          <div class="auth-tag">Sandbox Link – Secure Relay</div>
        </header>

        <div class="auth-body">
          <h1 class="auth-title">Ops Deck Access</h1>
          <p class="auth-subtitle">
            Enter the field PIN to attach this sandbox node to the active
            Team Shade relay. Non matching codes route into the decoy stream.
          </p>

          <div class="pin-wrapper" id="pin-wrapper">
            <div class="pin-row">
              <div class="pin-label-group">
                <div class="pin-label-primary">Field Pin</div>
                <div class="pin-label-secondary">Sandbox Authentication</div>
              </div>

              <div class="pin-input-group" id="pin-display">
                <div class="pin-input-slot empty" data-slot="0">•</div>
                <div class="pin-input-slot empty" data-slot="1">•</div>
                <div class="pin-input-slot empty" data-slot="2">•</div>
                <div class="pin-input-slot empty" data-slot="3">•</div>
              </div>
            </div>

            <input
              type="password"
              inputmode="numeric"
              maxlength="4"
              autocomplete="one-time-code"
              id="pin-input"
              class="pin-hidden-input"
            />

            <div class="pin-meta">
              <span>Linked: Stealth Relay Sandbox</span>
              <span>Pin required for live deck</span>
            </div>
          </div>
        </div>

        <footer class="auth-footer">
          <div class="auth-badge">
            <span class="auth-badge-dot"></span>
            <span>Secure Handshake Ready</span>
          </div>
          <div class="auth-hint">Enter 4 digit field code to continue</div>
        </footer>
      </section>
<!-- MAIN DASHBOARD LAYER -->
      <section class="dashboard-layer" id="dashboard-layer" style="display: none;">
        <header class="dash-header">
          <div class="dash-header-left">
            <div class="dash-title-block">
              <h2 class="dash-title">Signal Deck – Stealth Relay</h2>
              <p class="dash-subtitle">
                Live sandbox monitoring for Team Shade field relays. Matched codes attach to the
                primary stream, non matching codes stay sandboxed and quietly observed.
              </p>
            </div>

            <div class="dash-meta-tags">
              <span class="dash-tag dash-tag-primary">Sandbox Node – 9378 Scooter Ln</span>
              <span class="dash-tag dash-tag-soft">Mode: Stealth Observation</span>
            </div>
          </div>

          <div class="dash-header-right">
            <div class="cluster-indicator">
              <div class="cluster-dot cluster-dot-primary"></div>
              <div class="cluster-text-main">Cluster: Shade West</div>
              <div class="cluster-text-sub">Border Relay Mesh</div>
            </div>

            <div class="uptime-block">
              <div class="uptime-label">Node Uptime</div>
              <div class="uptime-value" id="uptime-display">00:00:00</div>
            </div>
          </div>
        </header>

        <main class="dash-main">
          <section class="signal-grid">
            <!-- PRIMARY SIGNAL COLUMN -->
            <article class="signal-column">
              <header class="signal-header">
                <div>
                  <h3 class="signal-title">Primary Relay Signal</h3>
                  <p class="signal-subtitle">Live blend of matched field codes</p>
                </div>

                <div class="signal-status" id="primary-status-chip">
                  <span class="status-dot status-dot-ok"></span>
                  <span class="status-label">Link: Idle</span>
                </div>
              </header>

              <div class="signal-visualizer" id="primary-visual">
                <div class="signal-bar" data-bar="0"></div>
                <div class="signal-bar" data-bar="1"></div>
                <div class="signal-bar" data-bar="2"></div>
                <div class="signal-bar" data-bar="3"></div>
                <div class="signal-bar" data-bar="4"></div>
                <div class="signal-bar" data-bar="5"></div>
                <div class="signal-bar" data-bar="6"></div>
                <div class="signal-bar" data-bar="7"></div>
              </div>

              <footer class="signal-footer">
                <div class="signal-footer-metric">
                  <span class="metric-label">Blend Stability</span>
                  <span class="metric-value" id="primary-stability">—</span>
                </div>
                <div class="signal-footer-metric">
                  <span class="metric-label">Last Matched Field Code</span>
                  <span class="metric-value" id="primary-last-code">None</span>
                </div>
              </footer>
            </article>

            <!-- SANDBOX / DECOY SIGNAL COLUMN -->
            <article class="signal-column">
              <header class="signal-header">
                <div>
                  <h3 class="signal-title">Sandbox / Decoy Stream</h3>
                  <p class="signal-subtitle">Non matching PINs stay parked here</p>
                </div>

                <div class="signal-status signal-status-soft" id="sandbox-status-chip">
                  <span class="status-dot status-dot-soft"></span>
                  <span class="status-label">Sandbox Listening</span>
                </div>
              </header>

              <div class="signal-visualizer signal-visualizer-soft" id="sandbox-visual">
                <div class="signal-bar" data-bar="0"></div>
                <div class="signal-bar" data-bar="1"></div>
                <div class="signal-bar" data-bar="2"></div>
                <div class="signal-bar" data-bar="3"></div>
                <div class="signal-bar" data-bar="4"></div>
                <div class="signal-bar" data-bar="5"></div>
                <div class="signal-bar" data-bar="6"></div>
                <div class="signal-bar" data-bar="7"></div>
              </div>

              <footer class="signal-footer">
                <div class="signal-footer-metric">
                  <span class="metric-label">Sandbox Load</span>
                  <span class="metric-value" id="sandbox-load">Low</span>
                </div>
                <div class="signal-footer-metric">
                  <span class="metric-label">Decoy Depth</span>
                  <span class="metric-value" id="sandbox-depth">Shallow</span>
                </div>
              </footer>
            </article>
          </section>

          <!-- STATUS + META GRID -->
          <section class="status-grid">
            <article class="status-card" id="link-card">
              <header class="status-card-header">
                <div>
                  <h3 class="status-card-title">Link State</h3>
                  <p class="status-card-subtitle">Stealth protocol handshake status</p>
                </div>
                <div class="status-pill" id="link-pill">
                  <span class="status-pill-dot"></span>
                  <span class="status-pill-text" id="link-pill-text">Idle – Awaiting PIN</span>
                </div>
              </header>

              <div class="status-body">
                <div class="status-row">
                  <span class="status-label">Current Mode</span>
                  <span class="status-value" id="mode-value">Sandbox Only</span>
                </div>
                <div class="status-row">
                  <span class="status-label">Stealth Route</span>
                  <span class="status-value" id="route-value">Decoy Mesh</span>
                </div>
                <div class="status-row">
                  <span class="status-label">Last Handshake</span>
                  <span class="status-value" id="handshake-value">None</span>
                </div>
              </div>
            </article>

            <article class="status-card" id="security-card">
              <header class="status-card-header">
                <div>
                  <h3 class="status-card-title">Security Envelope</h3>
                  <p class="status-card-subtitle">What happens when codes do or don’t match</p>
                </div>
              </header>

              <div class="status-body status-body-split">
                <div class="status-body-column">
                  <div class="status-row">
                    <span class="status-label">Matched Codes</span>
                    <span class="status-value">Attach to primary relay</span>
                  </div>
                  <div class="status-row">
                    <span class="status-label">Sandbox Traffic</span>
                    <span class="status-value">Observed only, never promoted</span>
                  </div>
                </div>
                <div class="status-body-column">
                  <div class="status-row">
                    <span class="status-label">Stealth Layer</span>
                    <span class="status-value">Decoy UI + muted signals</span>
                  </div>
                  <div class="status-row">
                    <span class="status-label">Relay Policy</span>
                    <span class="status-value">No direct write to core mesh</span>
                  </div>
                </div>
              </div>
            </article>

            <article class="status-card" id="sandbox-card">
              <header class="status-card-header">
                <div>
                  <h3 class="status-card-title">Sandbox Node – Local</h3>
                  <p class="status-card-subtitle">This specific link at your location</p>
                </div>
              </header>

              <div class="status-body">
                <div class="status-row">
                  <span class="status-label">Node Label</span>
                  <span class="status-value">Scooter Ln Relay</span>
                </div>
                <div class="status-row">
                  <span class="status-label">Geo Region</span>
                  <span class="status-value">El Paso Stealth Corridor</span>
                </div>
                <div class="status-row">
                  <span class="status-label">Node Role</span>
                  <span class="status-value">Observation & Testing</span>
                </div>
              </div>
            </article>
          </section>

          <!-- EVENT LOG / TERMINAL -->
          <section class="log-panel">
            <header class="log-header">
              <div>
                <h3 class="log-title">Event Stream</h3>
                <p class="log-subtitle">Live log of PIN attempts and route decisions</p>
              </div>
              <button class="log-clear-button" id="log-clear">Clear Log</button>
            </header>

            <div class="log-body" id="log-output"></div>
          </section>
        </main>
      </section>

<script>
      // --- CONFIG ---
      const CORRECT_PIN = "8236";
      const HANDSHAKE_INTERVAL_MS = 2800;
      const SIGNAL_TICK_MS = 260;

      // --- ELEMENT HOOKS ---
      const pinInput = document.getElementById("pin-input");
      const pinDisplaySlots = document.querySelectorAll(".pin-input-slot");
      const authLayer = document.getElementById("auth-layer");
      const dashboardLayer = document.getElementById("dashboard-layer");

      const primaryVisual = document.getElementById("primary-visual");
      const sandboxVisual = document.getElementById("sandbox-visual");
      const primaryStatusChip = document.getElementById("primary-status-chip");
      const sandboxStatusChip = document.getElementById("sandbox-status-chip");
      const primaryStabilityEl = document.getElementById("primary-stability");
      const primaryLastCodeEl = document.getElementById("primary-last-code");
      const sandboxLoadEl = document.getElementById("sandbox-load");
      const sandboxDepthEl = document.getElementById("sandbox-depth");

      const linkPill = document.getElementById("link-pill");
      const linkPillText = document.getElementById("link-pill-text");
      const modeValueEl = document.getElementById("mode-value");
      const routeValueEl = document.getElementById("route-value");
      const handshakeValueEl = document.getElementById("handshake-value");

      const uptimeDisplay = document.getElementById("uptime-display");
      const logOutput = document.getElementById("log-output");
      const logClearBtn = document.getElementById("log-clear");

      // Some users may paste the whole file without dashboard markup,
      // so guard against missing elements.
      const hasDashboard = !!dashboardLayer;

      // --- STATE ---
      let uptimeStart = Date.now();
      let handshakeTimer = null;
      let signalTimer = null;
      let attachedToPrimary = false;
      let lastGeoHop = null;

      const geoStates = [
        "TX – El Paso Corridor",
        "NM – High Desert Shell",
        "AZ – Borderline Mesh",
        "CA – Shadow Coast",
        "NV – Quiet Strip",
        "CO – Ridge Node",
        "UT – Basin Ghost",
      ];

      function formatTime(ms) {
        const totalSec = Math.floor(ms / 1000);
        const h = String(Math.floor(totalSec / 3600)).padStart(2, "0");
        const m = String(Math.floor((totalSec % 3600) / 60)).padStart(2, "0");
        const s = String(totalSec % 60).padStart(2, "0");
        return `${h}:${m}:${s}`;
      }

      function updateUptime() {
        uptimeDisplay.textContent = formatTime(Date.now() - uptimeStart);
      }

      function logEvent(message, type = "info") {
        if (!logOutput) return;
        const row = document.createElement("div");
        row.className = `log-row log-row-${type}`;
        const ts = new Date().toLocaleTimeString();
        row.textContent = `[${ts}] ${message}`;
        logOutput.prepend(row);
      }

      // --- PIN DISPLAY SYNC ---
      function syncPinSlots(value) {
        const chars = value.split("");
        pinDisplaySlots.forEach((slot, index) => {
          const char = chars[index];
          if (char) {
            slot.textContent = char;
            slot.classList.remove("empty");
          } else {
            slot.textContent = "•";
            slot.classList.add("empty");
          }
        });
      }

      function setLinkStatePrimaryAttached(code) {
        attachedToPrimary = true;
        if (primaryStatusChip) {
          primaryStatusChip.classList.remove("signal-status-soft");
          primaryStatusChip.querySelector(".status-label").textContent = "Link: Active";
        }
        if (sandboxStatusChip) {
          sandboxStatusChip.querySelector(".status-label").textContent = "Sandbox Monitoring";
        }
        if (linkPill && linkPillText) {
          linkPill.classList.add("status-pill-active");
          linkPillText.textContent = "Primary Relay Attached";
        }
        if (modeValueEl) modeValueEl.textContent = "Primary + Sandbox";
        if (routeValueEl) routeValueEl.textContent = "Stealth Primary Relay";
        if (primaryLastCodeEl) primaryLastCodeEl.textContent = code;
        if (primaryStabilityEl) primaryStabilityEl.textContent = "Stable";

        logEvent(`Field PIN ${code} matched – attached to primary relay`, "ok");
      }

      function setLinkStateSandboxOnly(code) {
        attachedToPrimary = false;
        if (primaryStatusChip) {
          primaryStatusChip.querySelector(".status-label").textContent = "Link: Idle";
        }
        if (sandboxStatusChip) {
          sandboxStatusChip.querySelector(".status-label").textContent = "Sandbox Listening";
        }
        if (linkPill && linkPillText) {
          linkPill.classList.remove("status-pill-active");
          linkPillText.textContent = "Idle – Sandbox Only";
        }
        if (modeValueEl) modeValueEl.textContent = "Sandbox Only";
        if (routeValueEl) routeValueEl.textContent = "Decoy Mesh";
        if (primaryLastCodeEl) primaryLastCodeEl.textContent = "None";
        if (primaryStabilityEl) primaryStabilityEl.textContent = "—";

        if (code) {
          logEvent(`Field PIN ${code} routed to sandbox / decoy`, "warn");
        } else {
          logEvent("Sandbox only mode – awaiting field PIN", "info");
        }
      }

      // --- GEO STATE HOPPER ---
      function hopGeoState() {
        const nextIndex = Math.floor(Math.random() * geoStates.length);
        const nextState = geoStates[nextIndex];
        lastGeoHop = nextState;
        const sandboxCard = document.getElementById("sandbox-card");
        if (!sandboxCard) return;
        const rows = sandboxCard.querySelectorAll(".status-row .status-value");
        if (rows[1]) {
          rows[1].textContent = nextState;
        }
        logEvent(`Geo route hop: ${nextState}`, "info");
      }

      // --- SIGNAL BLENDING VISUALS ---
      function randomAmplitude(base, variance) {
        const delta = Math.random() * variance;
        return base + delta;
      }

      function driveSignalVisualizer(container, attached) {
        if (!container) return;
        const bars = Array.from(container.querySelectorAll(".signal-bar"));
        const now = Date.now();
        bars.forEach((bar, index) => {
          const phase = (now / 400 + index * 0.65) % (Math.PI * 2);
          let base = attached ? 0.55 : 0.18;
          let variance = attached ? 0.35 : 0.22;
          const amp = base + Math.sin(phase) * variance;
          const height = Math.max(8, Math.min(100, Math.round(amp * 100)));
          bar.style.setProperty("--bar-height", `${height}%`);
          bar.style.height = `${height}%`;
        });
      }

      function startSignalLoop() {
        if (!hasDashboard) return;
        if (signalTimer) clearInterval(signalTimer);
        signalTimer = setInterval(() => {
          driveSignalVisualizer(primaryVisual, attachedToPrimary);
          driveSignalVisualizer(sandboxVisual, true);
        }, SIGNAL_TICK_MS);
      }

      // --- THREE-PRONG HANDSHAKE LOOP ---
      // Phases: 1) Sandbox ping 2) Geo hop 3) Relay decision
      function runHandshakeCycle() {
        if (!hasDashboard) return;

        // Phase 1: sandbox ping
        logEvent("Handshake step 1/3 – sandbox relay ping", "info");
        if (handshakeValueEl) handshakeValueEl.textContent = "Sandbox ping";

        setTimeout(() => {
          // Phase 2: geo hop
          hopGeoState();
          if (handshakeValueEl) handshakeValueEl.textContent = "Geo route adjust";

          setTimeout(() => {
            // Phase 3: relay decision
            if (attachedToPrimary) {
              if (handshakeValueEl) handshakeValueEl.textContent = "Primary relay locked";
              logEvent("Handshake step 3/3 – primary relay confirmed", "ok");
            } else {
              if (handshakeValueEl) handshakeValueEl.textContent = "Sandbox only";
              logEvent("Handshake step 3/3 – staying in sandbox / decoy", "warn");
            }
          }, HANDSHAKE_INTERVAL_MS / 3);
        }, HANDSHAKE_INTERVAL_MS / 3);
      }

      function startHandshakeLoop() {
        if (!hasDashboard) return;
        if (handshakeTimer) clearInterval(handshakeTimer);
        runHandshakeCycle();
        handshakeTimer = setInterval(runHandshakeCycle, HANDSHAKE_INTERVAL_MS);
      }

      // --- PIN HANDLING ---
      function handlePinComplete(value) {
        if (!hasDashboard) {
          logEvent("PIN entered but dashboard layer is missing from DOM", "warn");
          return;
        }

        if (value === CORRECT_PIN) {
          setLinkStatePrimaryAttached(value);
          authLayer.style.display = "none";
          dashboardLayer.style.display = "block";
          logEvent("Auth layer collapsed – dashboard promoted to live view", "ok");
        } else {
          setLinkStateSandboxOnly(value);
        }
        pinInput.value = "";
        syncPinSlots("");
      }

      function setupPinInput() {
        if (!pinInput) return;

        // Focus hidden input when user taps the slots area
        const pinWrapper = document.getElementById("pin-wrapper");
        const pinDisplay = document.getElementById("pin-display");
        [pinWrapper, pinDisplay].forEach((el) => {
          if (!el) return;
          el.addEventListener("click", () => {
            pinInput.focus();
          });
        });

        pinInput.addEventListener("input", (e) => {
          const value = e.target.value.replace(/[^0-9]/g, "");
          e.target.value = value.slice(0, 4);
          syncPinSlots(e.target.value);

          if (e.target.value.length === 4) {
            handlePinComplete(e.target.value);
          }
        });
      }

      function setupLogControls() {
        if (!logClearBtn || !logOutput) return;
        logClearBtn.addEventListener("click", () => {
          logOutput.innerHTML = "";
          logEvent("Log cleared by local node", "info");
        });
      }

      function bootstrap() {
        // Uptime ticker
        if (uptimeDisplay) {
          updateUptime();
          setInterval(updateUptime, 1000);
        }

        // Initial state
        setLinkStateSandboxOnly("");
        setupPinInput();
        setupLogControls();

        // Only start the fancy stuff if the dashboard exists
        if (hasDashboard) {
          startSignalLoop();
          startHandshakeLoop();
          logEvent("Sandbox node online – waiting for field PIN", "info");
        } else {
          logEvent("Sandbox node online – dashboard layer not detected", "warn");
        }
      }

      document.addEventListener("DOMContentLoaded", bootstrap);
    </script>
  </div>
</body>
</html>
